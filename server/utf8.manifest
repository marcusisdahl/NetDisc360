<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 the program's ANSI code page (Windows 10 1903 and later), so
     the A functions (FindFirstFileA, CreateFileA) open game files with any
     name, Japanese or accented, not only names the PC's own code page can
     spell. Merged into the exe's manifest (NetDisc.vcxproj). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
