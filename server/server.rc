// The launcher XEXs the server writes into each game folder, from build.ps1's
// build\NetISO Sync (built just before the server).
#include "resource.h"

// The program's icon (Explorer, taskbar, notification area): gui.cpp loads it as 1.
1 ICON "netiso.ico"

IDR_LAUNCHER RCDATA "..\\build\\NetISO Sync\\default.xex"
IDR_BOOT RCDATA "..\\build\\NetISO Sync\\boot.xex"
