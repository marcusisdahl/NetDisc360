// The launcher XEXs the server writes into each game folder, from build.ps1's
// build\NetISO Sync (built just before the server).
#include "resource.h"
#include "version.h"

// The program's icon (Explorer, taskbar, notification area): tray.cpp loads it as 1.
1 ICON "netiso.ico"

IDR_LAUNCHER RCDATA "..\\build\\NetISO Sync\\default.xex"
IDR_BOOT RCDATA "..\\build\\NetISO Sync\\boot.xex"

// Aurora's art (cover, background, icon and banner) for NetDisc360's own tile
// and for FastFTP360, which the server puts in Aurora's GameData folder.
IDR_ART_NETDISC_GC RCDATA "..\\art\\aurora\\netdisc360\\GCFFFF4E49.asset"
IDR_ART_NETDISC_BK RCDATA "..\\art\\aurora\\netdisc360\\BKFFFF4E49.asset"
IDR_ART_NETDISC_GL RCDATA "..\\art\\aurora\\netdisc360\\GLFFFF4E49.asset"
IDR_ART_FASTFTP_GC RCDATA "..\\art\\aurora\\fastftp360\\GCFFFF4646.asset"
IDR_ART_FASTFTP_BK RCDATA "..\\art\\aurora\\fastftp360\\BKFFFF4646.asset"
IDR_ART_FASTFTP_GL RCDATA "..\\art\\aurora\\fastftp360\\GLFFFF4646.asset"

// What Explorer and Task Manager show for the exe.
1 VERSIONINFO
FILEVERSION NETDISC_VERSION_NUMBERS
PRODUCTVERSION NETDISC_VERSION_NUMBERS
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Marcus Isdahl"
            VALUE "FileDescription", "NetDisc360"
            VALUE "FileVersion", NETDISC_VERSION
            VALUE "InternalName", "NetDisc"
            VALUE "LegalCopyright", "Copyright (c) 2026 Marcus Isdahl. MIT License."
            VALUE "OriginalFilename", "NetDisc360.exe"
            VALUE "ProductName", "NetDisc360"
            VALUE "ProductVersion", NETDISC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
