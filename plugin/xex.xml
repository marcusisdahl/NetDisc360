<?xml version="1.0"?>
<!-- The public imagexex refuses a system DLL (IM1038/IM1067), so the plugin
     is packaged as a title DLL at the base its PE header was patched to, and
     tools/sysdll.py then moves the XEX to the system base the code was linked
     at (0x91380000, between NetISO.xex and Aurora's Nova.xex), with NetISO's
     module and image flags. Uncompressed, so sysdll.py can hash the pages. -->
<xex>
  <format><uncompressed/></format>
</xex>
